{
    "manifest_version": 3,
    "name": "Duplicate Tab Inspector",
    "version": "2.0.0",
    "description": "Inspect, preview, and selectively close duplicate tabs across multi-level URL rules.",
    "permissions": [
        "tabs"
    ],
    "action": {
        "default_title": "Inspect Duplicate Tabs (Alt+Shift+D)"
    },
    "commands": {
        "open-inspector": {
            "suggested_key": {
                "default": "Alt+Shift+D"
            },
            "description": "Open Duplicate Tab Inspector"
        }
    },
    "background": {
        "service_worker": "background.js"
    }
}